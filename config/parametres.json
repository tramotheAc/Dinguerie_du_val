  "indicateurs": [
    {
      "id": "total_personnes",
      "groupe": "Foyer",
      "libelle": "Nombre de personnes",
      "format": "nombre",
      "formule": "adultes + enfants_moins_14 + enfants_14_plus"
    },
    {
      "id": "nb_enfants",
      "groupe": "Foyer",
      "libelle": "Nombre d'enfants",
      "format": "nombre",
      "formule": "enfants_moins_14 + enfants_14_plus"
    },
    {
      "id": "nb_uc",
      "groupe": "Foyer",
      "libelle": "Unités de consommation (échelle OCDE)",
      "format": "decimal",
      "formule": "1 + MAX(adultes - 1; 0) * 0,5 + enfants_moins_14 * 0,3 + enfants_14_plus * 0,5",
      "aide": "Le premier adulte compte pour 1, chaque autre personne de 14 ans et plus pour 0,5, chaque enfant de moins de 14 ans pour 0,3."
    },
    {
      "id": "parts_caf",
      "groupe": "Foyer",
      "libelle": "Parts estimées (principe CAF)",
      "format": "decimal",
      "formule": "MAX(adultes; 1) + SI(nb_enfants <= 2; nb_enfants * 0,5; 1 + (nb_enfants - 2))",
      "aide": "Une part par adulte, une demi-part pour chacun des deux premiers enfants, une part entière à partir du troisième."
    },
    {
      "id": "loyer_residuel",
      "groupe": "Logement",
      "libelle": "Loyer résiduel",
      "format": "euro",
      "formule": "MAX(loyer + charges - apl; 0)"
    },
    {
      "id": "mois_impayes",
      "groupe": "Logement",
      "libelle": "Nombre de mois d'impayés",
      "format": "decimal",
      "formule": "dette_locative / loyer_residuel",
      "aide": "Dette rapportée à ce que le locataire doit réellement payer chaque mois (loyer + charges − APL)."
    },
    {
      "id": "depenses_logement",
      "groupe": "Logement",
      "libelle": "Dépenses liées au logement",
      "format": "euro",
      "formule": "loyer_residuel + energie + eau + assurance_habitation"
    },
    {
      "id": "total_ressources",
      "groupe": "Totaux",
      "libelle": "Total des ressources",
      "format": "euro",
      "formule": "somme_ressources"
    },
    {
      "id": "total_charges_fixes",
      "groupe": "Totaux",
      "libelle": "Total des charges fixes",
      "format": "euro",
      "formule": "loyer_residuel + somme_charges_fixes"
    },
    {
      "id": "autres_charges_fixes_total",
      "groupe": "Totaux",
      "libelle": "Charges fixes hors logement",
      "format": "euro",
      "formule": "total_charges_fixes - depenses_logement"
    },
    {
      "id": "total_vie_courante",
      "groupe": "Totaux",
      "libelle": "Total vie courante",
      "format": "euro",
      "formule": "somme_vie_courante"
    },
    {
      "id": "total_facultatives",
      "groupe": "Totaux",
      "libelle": "Total des dépenses facultatives",
      "format": "euro",
      "formule": "somme_facultatives"
    },
    {
      "id": "total_charges",
      "groupe": "Totaux",
      "libelle": "Charges totales (hors remboursement de dettes)",
      "format": "euro",
      "formule": "total_charges_fixes + total_vie_courante + total_facultatives"
    },
    {
      "id": "total_charges_avec_dettes",
      "groupe": "Totaux",
      "libelle": "Charges totales, dettes comprises",
      "format": "euro",
      "formule": "total_charges + dettes_mensualites"
    },
    {
      "id": "solde_budgetaire",
      "groupe": "Totaux",
      "libelle": "Solde budgétaire (ressources − charges)",
      "format": "euro",
      "formule": "total_ressources - total_charges"
    },
    {
      "id": "solde_apres_dettes",
      "groupe": "Totaux",
      "libelle": "Solde disponible après dettes",
      "format": "euro",
      "formule": "total_ressources - total_charges - dettes_mensualites"
    },
    {
      "id": "quotient_familial",
      "groupe": "Ratios",
      "libelle": "Quotient familial mensuel estimé",
      "format": "euro",
      "formule": "total_ressources / parts_caf"
    },
    {
      "id": "taux_effort_logement",
      "groupe": "Ratios",
      "libelle": "Taux d'effort logement",
      "format": "pourcent",
      "formule": "depenses_logement / total_ressources"
    },
    {
      "id": "taux_endettement",
      "groupe": "Ratios",
      "libelle": "Taux d'endettement (crédits)",
      "format": "pourcent",
      "formule": "credits / total_ressources"
    },
    {
      "id": "taux_remboursement_dettes",
      "groupe": "Ratios",
      "libelle": "Taux de remboursement des dettes",
      "format": "pourcent",
      "formule": "dettes_mensualites / total_ressources"
    },
    {
      "id": "taux_endettement_global",
      "groupe": "Ratios",
      "libelle": "Taux d'endettement global (crédits + dettes)",
      "format": "pourcent",
      "formule": "(credits + dettes_mensualites) / total_ressources"
    },
    {
      "id": "part_facultatives",
      "groupe": "Ratios",
      "libelle": "Part des dépenses facultatives",
      "format": "pourcent",
      "formule": "total_facultatives / total_ressources"
    },
    {
      "id": "rav_uc",
      "groupe": "Ratios",
      "libelle": "Reste à vivre par UC après dettes",
      "format": "euro",
      "formule": "solde_apres_dettes / nb_uc",
      "aide": "Ce qu'il reste réellement au ménage après toutes ses charges et remboursements, rapporté à sa composition familiale. C'est un indicateur de fragilité, pas forcément de capacité d'apurement."
    },
    {
      "id": "credit_conso",
      "groupe": "Ratios",
      "libelle": "Crédit à la consommation présent",
      "format": "booleen",
      "formule": "credits > 0"
    },
    {
      "id": "score_effort",
      "groupe": "Score",
      "libelle": "Score du taux d'effort logement",
      "format": "nombre",
      "formule": "SI(taux_effort_logement <= 25%; 30; SI(taux_effort_logement <= 35%; 20; SI(taux_effort_logement <= 40%; 10; 0)))"
    },
    {
      "id": "score_endettement",
      "groupe": "Score",
      "libelle": "Score d'endettement global",
      "format": "nombre",
      "formule": "SI(taux_endettement_global <= 10%; 25; SI(taux_endettement_global <= 20%; 15; SI(taux_endettement_global <= 30%; 5; 0)))"
    },
    {
      "id": "score_rav",
      "groupe": "Score",
      "libelle": "Score du reste à vivre",
      "format": "nombre",
      "formule": "SI(rav_uc >= 700; 25; SI(rav_uc >= 500; 15; SI(rav_uc >= 300; 5; 0)))"
    },
    {
      "id": "score_anciennete",
      "groupe": "Score",
      "libelle": "Score d'ancienneté de l'impayé",
      "format": "nombre",
      "formule": "SI(dette_locative <= 0; 20; SI(mois_impayes < 1; 20; SI(mois_impayes < 3; 15; SI(mois_impayes < 6; 5; 0))))"
    },
    {
      "id": "score_budgetaire",
      "groupe": "Score",
      "libelle": "Score de fragilité budgétaire",
      "format": "score",
      "formule": "score_effort + score_endettement + score_rav + score_anciennete"
    },
    {
      "id": "apurement_mini",
      "groupe": "Plan d'apurement",
      "libelle": "Fourchette d'apurement : mini",
      "format": "euro",
      "formule": "SI(solde_apres_dettes <= 0; 0; BAREME(\"fourchette_apurement\"; solde_apres_dettes; \"mini\"))"
    },
    {
      "id": "apurement_maxi",
      "groupe": "Plan d'apurement",
      "libelle": "Fourchette d'apurement : maxi",
      "format": "euro",
      "formule": "SI(solde_apres_dettes <= 0; 0; BAREME(\"fourchette_apurement\"; solde_apres_dettes; \"maxi\"))"
    },
    {
      "id": "coefficient_score",
      "groupe": "Plan d'apurement",
      "libelle": "Position dans la fourchette (selon le score)",
      "format": "pourcent",
      "formule": "BAREME(\"coefficient_score\"; score_budgetaire; \"coefficient\")",
      "aide": "0 % = mini de la fourchette, 100 % = maxi."
    },
    {
      "id": "correction_rav",
      "groupe": "Plan d'apurement",
      "libelle": "Correction selon le reste à vivre par UC",
      "format": "euro",
      "formule": "BAREME(\"correction_rav\"; rav_uc; \"correction\")"
    },
    {
      "id": "mensualite_conseillee",
      "groupe": "Plan d'apurement",
      "libelle": "Mensualité conseillée",
      "format": "euro",
      "formule": "SI(OU(dette_locative <= 0; solde_apres_dettes <= 0); 0; ARRONDI(MIN(MAX(apurement_mini + coefficient_score * (apurement_maxi - apurement_mini) + correction_rav; 0); solde_apres_dettes * plafond_effort_apurement; dette_locative); 0))",
      "aide": "Position dans la fourchette selon le score, corrigée selon le reste à vivre, plafonnée à une part du solde après dettes et au montant de la dette."
    },
    {
      "id": "mensualite_retenue",
      "groupe": "Plan d'apurement",
      "libelle": "Mensualité retenue",
      "format": "euro",
      "formule": "SI(mensualite_saisie > 0; MIN(mensualite_saisie; dette_locative); mensualite_conseillee)",
      "aide": "La mensualité conseillée, sauf si le conseiller en simule une autre sur la synthèse."
    },
    {
      "id": "duree_plan",
      "groupe": "Plan d'apurement",
      "libelle": "Durée estimée du plan",
      "format": "mois",
      "formule": "SI(mensualite_retenue > 0; ARRONDI.SUP(dette_locative / mensualite_retenue; 0); 0)"
    },
    {
      "id": "effort_apurement",
      "groupe": "Plan d'apurement",
      "libelle": "Part du solde après dettes consacrée au plan",
      "format": "pourcent",
      "formule": "mensualite_retenue / solde_apres_dettes"
    }
  ],
